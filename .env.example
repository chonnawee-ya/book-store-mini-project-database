# ==============================================================================
# Environment Configuration
# ==============================================================================
# SECRET KEY for Flask sessions
SECRET_KEY=ebook_store_super_secure_secret_key_2026

# DATABASE MODE:
# 1. Local SQLite (Default - if DATABASE_URL is not set):
# DB_TYPE=sqlite

# 2. Cloud PostgreSQL / Supabase (Recommended):
# ก๊อปปี้ URI จาก Supabase (Project Settings -> Database -> Connection string -> URI)
# เปลี่ยน [YOUR-PASSWORD] เป็นรหัสผ่านจริงของคุณ
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# 3. Cloud MySQL Configuration (Optional):
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=ebook_store
