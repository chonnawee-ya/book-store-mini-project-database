# ==============================================================================
# Environment Configuration
# ==============================================================================
# SECRET KEY for Flask sessions
SECRET_KEY=ebook_store_super_secure_secret_key_2026

# DATABASE MODE:
# Leave empty or set DB_TYPE=sqlite to use local SQLite (ebook_store.db)
# Or set DB_TYPE=mysql and fill in the MySQL parameters for Cloud Database
DB_TYPE=sqlite

# Cloud MySQL Configuration (e.g. Railway, TiDB Cloud, Aiven, Cleaver Cloud)
# Method 1: Connection URL (Railway / Render standard)
# DATABASE_URL=mysql://root:password@containers-us-west-123.railway.app:3306/railway

# Method 2: Individual variables
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ebook_store
